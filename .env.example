PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/journova.sqlite
UPLOAD_DIRECTORY=./data/uploads

# Configure SMTP to enable real email sign-in codes.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Optional origin allow-list for reverse-proxy/production deployments.
APP_ORIGIN=

# Comma-separated allowlist of existing account emails that may review documents.
ADMIN_EMAILS=
